# syntax=docker/dockerfile:1
FROM docker.io/library/rust:1.91-bookworm AS build
RUN rustup target add wasm32-unknown-unknown \
 && cargo install --locked trunk
WORKDIR /src
COPY . .
RUN cd crates/console-shell && trunk build --release \
 && cd /src && cargo build --release --locked -p console-gateway

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/console-gateway /usr/local/bin/console-gateway
COPY --from=build /src/crates/console-shell/dist /srv/console
ENV CONSOLE_DIST=/srv/console CONSOLE_LISTEN=0.0.0.0:8080
EXPOSE 8080
USER nonroot
ENTRYPOINT ["/usr/local/bin/console-gateway"]
