# Single source of truth for local stack / E2E ports (DEV ONLY).
# Read by: Makefile (include + --env-file for compose), compose.yaml
# (Caddy ports + Keycloak realm placeholders), e2e/playwright.config.ts.
# Override any value from the environment, e.g. `CONSOLE_TLS_PORT_MAIN=9543 make e2e`.
#
# Defaults avoid 8442-8445: on the maintainer Mac 8443/8444 belong to other
# projects, and a crashed podman tls-proxy start can leave podman's gvproxy
# holding a stale forward (e.g. 127.0.0.1:8442) after `make down`. Remedy for
# such a stale forward: `podman machine stop && podman machine start`.
#
# Browser-facing Caddy TLS ports (https://localhost:<port>), and the host
# gateway each one proxies to (http://127.0.0.1:<port>).
CONSOLE_TLS_PORT_RUN=9442
CONSOLE_GW_PORT_RUN=8080
CONSOLE_TLS_PORT_MAIN=9443
CONSOLE_GW_PORT_MAIN=8081
CONSOLE_TLS_PORT_DIST=9444
CONSOLE_GW_PORT_DIST=8082
CONSOLE_TLS_PORT_IDLE=9445
CONSOLE_GW_PORT_IDLE=8083
# Gateway variant requiring an acr the dev realm never issues (SEC-002 E2E).
CONSOLE_TLS_PORT_ACR=9446
CONSOLE_GW_PORT_ACR=8084
# Rate-limit spec gateway: reached directly over http (API-only, no cookies,
# so no Caddy); its own process so exhausting /login never throttles others.
CONSOLE_GW_PORT_RL=8085
# Rate-limit gateway trusting no proxy: asserts spoofed X-Forwarded-For from an
# untrusted peer is ignored (security NIT-1). Direct http, no Caddy.
CONSOLE_GW_PORT_RL_UNTRUSTED=8086
# M4 tool origins (plan §0/§9): each registry tool has its own browser origin.
# Port-distinct origins on localhost proxy to the gateway that owns the
# registry entry; the gateway routes on the Host header incl. the port.
# Known DEV-only gap: cookies ignore ports (cookie tossing between localhost
# ports); the CI-only prodlike project uses real hostnames to test that.
CONSOLE_TLS_PORT_TOOL_HELLO=9447
CONSOLE_TLS_PORT_TOOL_EVIL=9448
# hello tool origin for `make run` (run gateway registry).
CONSOLE_TLS_PORT_TOOL_RUN=9449
# hello-tool server (host process, plain http on loopback; upstream of the proxy).
CONSOLE_PORT_HELLO_UPSTREAM=8090
# (No ABS gateway: CONSOLE_SESSION_ABSOLUTE_SECS has a 900 s floor, so the
# absolute-expiry E2E moves absolute_expires_at via db-helpers instead.)
# Gateway whose IdP token endpoint is unreachable (keepalive 503 E2E, brief Q6).
CONSOLE_TLS_PORT_KA503=9451
CONSOLE_GW_PORT_KA503=8088
# Forward proxy used only by the KA503 gateway (passes discovery/JWKS, refuses
# the token endpoint). Started by Playwright; loopback http.
CONSOLE_PORT_KA503_PROXY=8091
# prodlike (CI only, /etc/hosts: console.ops.test, hello.tools.ops.test,
# evil.tools.ops.test -> 127.0.0.1): one TLS port, SNI-routed by Caddy.
CONSOLE_TLS_PORT_PRODLIKE=9452
CONSOLE_GW_PORT_PRODLIKE=8089
# Second hello-tool server for the prodlike gateway (its own assertion iss).
CONSOLE_PORT_HELLO_UPSTREAM_PRODLIKE=8092
# Fix round 1 (SEC-002/NIST-001): evil tool origin served by the IDLE gateway
# (150 s idle) so a tool-refresh spam can be checked against the real idle
# schedule, and the hello-tool server that verifies that gateway's assertions.
CONSOLE_TLS_PORT_TOOL_IDLE=9453
CONSOLE_PORT_HELLO_UPSTREAM_IDLE=8093
# M5 dcim tool (usg-dcim finch + otter-go; plan U3). Tool origins: main
# gateway (E2E) and run gateway (make run). The upstream is finch's nginx
# (dist/ + /api -> otter-go); otter-go and its Postgres are behind it on
# loopback only. If nothing listens on the upstream, only /t/dcim/ fails
# (gateway 502 BadGateway); the console and hello stay usable.
CONSOLE_TLS_PORT_TOOL_DCIM=9454
CONSOLE_TLS_PORT_TOOL_DCIM_RUN=9455
CONSOLE_PORT_DCIM_UPSTREAM=8094
CONSOLE_PORT_DCIM_API=8095
CONSOLE_PORT_DCIM_PG=5442
