# DEV ONLY gateway config for the local compose stack (make run / make e2e).
# Every secret below is a throwaway dev value; production uses *_FILE mounts.
CONSOLE_LISTEN=127.0.0.1:8080
CONSOLE_DIST=crates/console-shell/dist-gallery
CONSOLE_PUBLIC_URL=https://localhost:9442
# ^ make run / Playwright override this from ports.env (CONSOLE_TLS_PORT_*).
CONSOLE_OIDC_ISSUER=http://127.0.0.1:8180/realms/icam
CONSOLE_OIDC_CLIENT_ID=usg-ops-console
# DEV ONLY secret (matches keycloak/realm-dev.json). Gateway warns when the
# non-_FILE form is used.
CONSOLE_OIDC_CLIENT_SECRET=dev-only-console-secret
CONSOLE_DATABASE_URL=postgres://console:dev-only-console-db@127.0.0.1:5432/console?sslmode=disable
CONSOLE_AUDIT_DATABASE_URL=postgres://console_audit:dev-only-audit-db@127.0.0.1:5432/console?sslmode=disable
# SEC-006: migrations run as console_migrator (member of NOLOGIN console_owner).
# Dev convenience: `serve` migrates at startup when this is set. Production
# runs `console-gateway migrate` as a one-shot job and leaves this unset.
CONSOLE_MIGRATOR_DATABASE_URL=postgres://console_migrator:dev-only-migrator-db@127.0.0.1:5432/console?sslmode=disable
CONSOLE_TRUSTED_PROXIES=127.0.0.1/32
CONSOLE_SESSION_IDLE_SECS=900
CONSOLE_SESSION_ABSOLUTE_SECS=43200
CONSOLE_REQUIRED_ROLE=console-user
# SEC-002/NIST-002: accepted id_token acr values (sent as acr_values). The dev
# realm (keycloak/realm-dev.json, flow browser-loa-dev) maps password login at
# LoA 1 to this DEV ONLY value, also on SSO reuse. icam/production: the acr the
# X.509/CAC flow is mapped to. Required unless CONSOLE_DEV_MODE=true; this file
# deliberately leaves dev mode off (all DB hosts are loopback).
CONSOLE_REQUIRED_ACR=urn:usg-ops-console:dev:password
# M4 tools (make run / Playwright set these per gateway; see Makefile `run`):
#   CONSOLE_TOOLS_REGISTRY_FILE=target/e2e-tools/registry.run.toml
#     (rendered from deploy/compose/tools/registry.run.toml by `make up`;
#      unset = no tools; set but invalid = boot fails)
#   CONSOLE_ASSERTION_KEY_FILE=deploy/compose/secrets/assertion.key
#     (DEV ONLY, generated by `make up`; required when the registry has tools)
#   CONSOLE_TOOL_SESSION_HMAC_KEY_FILE=deploy/compose/secrets/tool-session-hmac.key
#     (DEV ONLY, generated by `make up` as 64 base64 chars, which the gateway
#      decodes to 48 bytes. Raw binary files (>= 32 bytes, used untrimmed) and
#      other text (>= 32 bytes after trim) are also accepted; key for the per-tool
#      session pseudonym `sid`. REQUIRED when the registry has tools unless
#      CONSOLE_DEV_MODE=true (boot fails otherwise; SEC-005/NIST-004). Only dev
#      mode may derive it from the assertion key.)
# DB pool (per replica): CONSOLE_DB_MAX_CONNECTIONS (default 32, 1..=200; the
# pool is the proxy hot path, one round trip per request) plus
# CONSOLE_AUDIT_DB_MAX_CONNECTIONS (default 4) = 36 per replica. Postgres/CNPG
# default max_connections=100 (3 reserved) fits two replicas; for 3+ replicas
# raise max_connections or front Postgres with a pooler (PgBouncer/CNPG Pooler,
# transaction mode) and size this per replica.
#   CONSOLE_DB_MAX_CONNECTIONS=32
# Optional: CONSOLE_ASSERTION_PUBLISH_KEYS_FILE (SPKI PEM bundle),
# CONSOLE_OIDC_REFRESH_TIMEOUT_SECS (default 4, 1..=10).
# Registry TOML: optional top-level `schema = 1`; `insecure_http_upstream = true`
# needs `insecure_http_upstream_reason` (non-empty, <= 200 chars) and is
# audited at startup (registry.insecure_upstream). Loopback http upstreams,
# as in deploy/compose/tools/, need neither.
