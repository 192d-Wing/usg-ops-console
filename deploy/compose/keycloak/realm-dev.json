  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": false,
  "browserFlow": "browser-loa-dev",
  "authenticationFlows": [
    {
      "alias": "browser-loa-dev",
      "description": "DEV ONLY: cookie SSO or password form at LoA 1 (acr urn:usg-ops-console:dev:password)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-loa-dev forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-loa-dev forms",
      "description": "forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "browser-loa-dev level 1",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-loa-dev level 1",
      "description": "LoA 1 = password (DEV stand-in for CAC/PIV)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa1-dev",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "loa1-dev",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "43200"
      }
    }
  ]
