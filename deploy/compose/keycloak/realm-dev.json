{
  "realm": "icam",
  "enabled": true,
  "displayName": "icam (DEV ONLY - local compose)",
  "attributes": {
    "dev_only": "true",
    "acr.loa.map": "{\"urn:usg-ops-console:dev:password\": 1}"
  },
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "console-user",
        "description": "Required to obtain a usg-ops-console session (CONSOLE_REQUIRED_ROLE)"
      },
      {
        "name": "console-admin",
        "description": "usg-ops-console admin (carried in roles; enforced from M6)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "usg-ops-console",
      "name": "usg-ops-console (DEV ONLY)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-console-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "redirectUris": [
        "https://localhost:${CONSOLE_TLS_PORT_RUN}/callback",
        "https://localhost:${CONSOLE_TLS_PORT_MAIN}/callback",
        "https://localhost:${CONSOLE_TLS_PORT_DIST}/callback",
        "https://localhost:${CONSOLE_TLS_PORT_IDLE}/callback",
        "https://localhost:${CONSOLE_TLS_PORT_ACR}/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:${CONSOLE_TLS_PORT_RUN}/logged-out##https://localhost:${CONSOLE_TLS_PORT_MAIN}/logged-out##https://localhost:${CONSOLE_TLS_PORT_DIST}/logged-out##https://localhost:${CONSOLE_TLS_PORT_IDLE}/logged-out##https://localhost:${CONSOLE_TLS_PORT_ACR}/logged-out",
        "client.session.idle.timeout": "900",
        "client.session.max.lifespan": "43200",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "acr.loa.map": "{\"urn:usg-ops-console:dev:password\": 1}",
        "default.acr.values": "urn:usg-ops-console:dev:password"
      },
      "protocolMappers": [
        {
          "name": "realm roles (id_token)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience usg-ops-console",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "usg-ops-console",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "console_user",
      "email": "console_user@console.dev.invalid",
      "firstName": "Console",
      "lastName": "User",
